# ==============================================================
# FILE .ENV.EXAMPLE - TEMPLATE CẤU HÌNH
# Copy file này thành .env và điền thông tin thật vào
# ==============================================================

# --- DJANGO CORE ---
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
# ⚠️ Khi chạy LOCAL thì đổi thành DEBUG=True
# ⚠️ Khi deploy PRODUCTION thì giữ DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- DATABASE (PostgreSQL + PostGIS) ---
DB_NAME=duangismoi
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- EMAIL (Gmail SMTP) ---
# Hướng dẫn lấy App Password Gmail:
# 1. Vào https://myaccount.google.com/security
# 2. Bật 2-Step Verification
# 3. Tìm "App passwords" → Tạo mật khẩu cho "Mail"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Urban Manager <your_gmail@gmail.com>

# --- RENDER / PRODUCTION ---
# DATABASE_URL=postgresql://user:pass@host/dbname
